#!/bin/sh /etc/rc.common

START=99
STOP=98

PROG=/etc/init.d/zerotier
FW4_LOCK=/var/run/fw4.lock

EXTRA_COMMANDS="sync"
EXTRA_HELP="	sync	Re-sync firewall zone membership and interface sections
	for currently joined ZeroTier networks (also driven by hotplug
	on zt* device add/remove)"

get_config() {
	config_get_bool enabled $1 enabled 0
	config_get_bool nat $1 nat 0
}

log() {
	echo "$@"
	logger -t luci-zerotier "$@"
}

validate_path() {
	# $2 = kind: "file" (local_conf_path) additionally allows the upstream
	# package's conventional single-file location /etc/zerotier.conf and
	# volatile /tmp (harmless there — the daemon only uses it if present);
	# "dir" (config_path) requires a persistent location: the daemon
	# refuses to start when config_path is missing, so /tmp would leave
	# it dead after every reboot.
	case "$2:$1" in
		file:/etc/zerotier.conf|file:/etc/zerotier/*|file:/tmp|file:/tmp/*)
			return 0
			;;
		dir:/etc/zerotier|dir:/etc/zerotier/*)
			return 0
			;;
	esac
	log "Invalid path rejected: $1"
	return 1
}

# fw4 holds /var/run/fw4.lock exclusively for the entire start/reload run,
# INCLUDING the execution of script includes. Calling "firewall reload" from
# such a context re-enters fw4 and deadlocks on that lock until the include
# is SIGKILLed after 30s — and the orphaned nested fw4 process then starts
# a self-sustaining reload cascade (reproduced on 24.10.7: ~36s cycles,
# growing process backlog, zone flapping). So: only reload when the lock
# is free. If the lock is held, whoever holds it has already rendered the
# ruleset from the uci state we just committed, so skipping is safe.
fw_reload() {
	: >> "$FW4_LOCK" 2>/dev/null
	if flock -n "$FW4_LOCK" true 2>/dev/null; then
		/etc/init.d/firewall reload
	else
		log "fw4 lock is held (reload/include in progress), skipping explicit reload"
	fi
}

any_rules_present() {
	local s
	for s in zerotier zerotier_lan lan_zerotier zerotier_wan; do
		[ -n "$(uci -q get "firewall.$s")" ] && return 0
	done
	return 1
}

rules_present() {
	[ "$(uci -q get firewall.zerotier)" = "zone" ] || return 1
	[ "$(uci -q get firewall.zerotier.name)" = "zerotier" ] || return 1
	# No legacy device matching: the pre-r29 zone matched raw devices via
	# the 'zt+' glob (or explicit names after a LuCI re-save). Force a
	# rewrite when those entries linger so every install converges on the
	# network-list design.
	[ -z "$(uci -q get firewall.zerotier.device)" ] || return 1
	[ "$(uci -q get firewall.zerotier_lan)" = "forwarding" ] || return 1
	[ "$(uci -q get firewall.lan_zerotier)" = "forwarding" ] || return 1
	[ "$(uci -q get firewall.zerotier_wan)" = "forwarding" ] || return 1
	return 0
}

# NOTE on transaction structure: every "uci commit firewall" fires procd's
# config trigger, which makes fw4 re-render ASYNCHRONOUSLY. When a previous
# commit's render is still in flight while we issue our next batch of uci
# commands, individual uci CLI invocations can fail intermittently ("uci:
# Invalid argument") and committed state silently loses options (observed on
# 24.10.7: the zone's 'name' vanished, fw4 then skipped the zone and all
# forwardings — NAT silently broken). Therefore:
#   1. All edits of one phase happen in a SINGLE "uci batch" invocation
#      (one delta load/save cycle — no inter-command window).
#   2. The committed result is verified afterwards; the whole transaction is
#      retried on failure. Intermediate async renders may still read a partial
#      state, but the render triggered by our final commit always sees the
#      complete state (eventual consistency), and the committed state itself
#      is guaranteed intact by the verify-retry loop.

# Zone membership design (r29+): each joined ZeroTier network gets a
# proto 'none' (unmanaged) netifd interface named zerotier_<nwid> bound to
# the runtime device, and the firewall zone matches via its 'network' list.
# The daemon keeps managing addresses on the devices itself — the interface
# sections only register them with netifd so that:
#   - LuCI's zone widgets show the networks (a device-only zone renders as
#     "(empty)" in the port-forward source-zone picker, which only lists
#     zone *networks*)
#   - the zone editor's device field no longer carries the 'zt+' glob,
#     which LuCI's DeviceSelect flags as a non-existent device and drops
#     on the next zone save (that is how explicit device lists crept in)
#   - interface status is visible on the Network > Interfaces page
# The set is (re)computed from `zerotier-cli listnetworks` on service
# start/reload and from the net hotplug hook when zt* devices appear or
# vanish — no readiness gating is needed, the zone simply tracks whatever
# is currently joined.
# Apply the complete desired state in ONE uci transaction: interface
# sections, the zone (WITH its network membership list) and the
# forwardings are committed together. r29's first deployment wrote the
# zone in one step and the membership in a follow-up — the gap between
# them committed a zone matching nothing, which cut the management link.
# Ordering after commit matters too: reload_config (netifd) first so the
# zone's networks resolve to actual devices, fw4 second.
apply_state() {
	local nets="$1"
	if state_ok "$nets"; then
		log "ZeroTier firewall state already in sync, nothing to do"
		return 0
	fi
	local attempt batch keep sec nwid dev name
	for attempt in 1 2 3; do
		batch=""
		keep=""
		while read -r nwid dev name; do
			[ -n "$nwid" ] || continue
			sec="zerotier_$nwid"
			keep="$keep $sec"
			batch="${batch}set network.$sec='interface'
set network.$sec.proto='none'
set network.$sec.device='$dev'
set network.$sec.label='ZeroTier $name'
"
		done <<EOF
$nets
EOF
		for sec in $(list_ifaces); do
			case " $keep " in *" $sec "*) ;; *) batch="${batch}delete network.$sec
" ;; esac
		done
		# zerotier -> lan: 让 zerotier 客户端访问局域网
		# lan -> zerotier: 让局域网设备通过 zerotier 互访
		# zerotier -> wan: 让 zerotier 客户端通过本机 WAN 上网（网关模式）
		batch="${batch}delete firewall.zerotier
set firewall.zerotier=zone
set firewall.zerotier.name='zerotier'
set firewall.zerotier.input='ACCEPT'
set firewall.zerotier.output='ACCEPT'
set firewall.zerotier.forward='ACCEPT'
set firewall.zerotier.masq='1'
"
		for sec in $keep; do
			batch="${batch}add_list firewall.zerotier.network='$sec'
"
		done
		batch="${batch}delete firewall.zerotier_lan
set firewall.zerotier_lan=forwarding
set firewall.zerotier_lan.src='zerotier'
set firewall.zerotier_lan.dest='lan'
delete firewall.lan_zerotier
set firewall.lan_zerotier=forwarding
set firewall.lan_zerotier.src='lan'
set firewall.lan_zerotier.dest='zerotier'
delete firewall.zerotier_wan
set firewall.zerotier_wan=forwarding
set firewall.zerotier_wan.src='zerotier'
set firewall.zerotier_wan.dest='wan'
"
		printf '%s' "$batch" | uci -q batch
		uci -q commit network
		uci -q commit firewall
		if state_ok "$nets"; then
			reload_config
			sleep 2
			fw_reload
			log "ZeroTier firewall zone and interfaces applied ($(printf '%s\n' $keep | sed '/^$/d' | wc -l) networks)"
			return 0
		fi
		log "uci transaction incomplete (attempt $attempt), retrying..."
		sleep 1
	done
	# Never leave the running ruleset behind the committed state — a stale
	# empty zone after a partial transition is what severs management access.
	reload_config
	sleep 2
	fw_reload
	log "ERROR: ZeroTier state sync failed after 3 attempts (rendered committed state)"
	return 1
}

delete_rules() {
	uci -q batch <<-'EOF'
		delete firewall.zerotier
		delete firewall.zerotier_lan
		delete firewall.lan_zerotier
		delete firewall.zerotier_wan
	EOF
}

remove_rules() {
	local attempt
	any_rules_present || return 0
	for attempt in 1 2 3; do
		delete_rules
		uci commit firewall
		if ! any_rules_present; then
			fw_reload
			log "Removed uci firewall rules for ZeroTier"
			return 0
		fi
		log "uci delete incomplete (attempt $attempt), retrying..."
		sleep 1
	done
	log "ERROR: failed to remove firewall rules after 3 attempts"
	return 1
}

# name cannot be derived from the network id (it is minted by the daemon),
# so the CLI output is the only authoritative source. Field positions are
# parsed defensively: nwid is fixed at $3, the device is located by its
# zt<alnum> shape, and the network name (which may contain spaces) is what
# remains between them — labels are sanitized to uci-safe characters.
get_nets() {
	local port
	config_get port global port 9993
	{ zerotier-cli listnetworks 2>/dev/null || zerotier-cli -p"$port" listnetworks 2>/dev/null; } | awk '
		/^200 listnetworks/ && length($3) == 16 && $3 ~ /^[0-9a-fA-F]+$/ {
			line = $0
			sub(/^200 listnetworks [0-9a-fA-F]+ /, "", line)
			if (match(line, / zt[0-9A-Za-z]+ /)) {
				dev = substr(line, RSTART + 1, RLENGTH - 2)
				rest = substr(line, 1, RSTART - 1)
				sub(/ [0-9a-f:]+ [A-Z]+ [A-Z]+$/, "", rest)
				sub(/[[:space:]]+$/, "", rest)
				gsub(/[^0-9A-Za-z _-]/, "", rest)
				if (rest != "") print $3, dev, rest
			}
		}'
}

# Enumerate existing zerotier_* interface sections in /etc/config/network.
list_ifaces() {
	uci -q show network 2>/dev/null | sed -n 's/^network\.\(zerotier_[0-9A-Fa-f]*\)=interface$/\1/p'
}

# Parse the zone's network list out of `uci show` output. List options are
# packed onto a SINGLE line as network='v1' 'v2' — split the quoted values
# apart. (Getting this wrong was the r29 deployment outage: verification
# could never match, so the post-commit reload never ran while the zone
# rewrite had already dropped the old device matching.)
zone_nets() {
	uci -q show firewall.zerotier 2>/dev/null \
		| sed -n "s/^firewall\.zerotier\.network='\(.*\)'\$/\1/p" \
		| tr "'" '\n' \
		| sed '/^[[:space:]]*$/d; s/^[[:space:]]*//; s/[[:space:]]*$//'
}

# Verify helper: every joined network has a proto=none interface bound to
# the current device, no stale sections remain, and the zone network list
# equals exactly the current set.
ifaces_synced() {
	local nets="$1" want="" nwid dev name sec
	while read -r nwid dev name; do
		[ -n "$nwid" ] || continue
		sec="zerotier_$nwid"
		[ "$(uci -q get "network.$sec.proto")" = "none" ] || return 1
		[ "$(uci -q get "network.$sec.device")" = "$dev" ] || return 1
		want="$want $sec "
	done <<EOF
$nets
EOF
	local sec2
	for sec2 in $(list_ifaces); do
		case "$want" in *" $sec2 "*) ;; *) return 1 ;; esac
	done
	local want_sorted cur_sorted
	want_sorted="$(printf '%s\n' $want | sed '/^$/d' | sort)"
	cur_sorted="$(zone_nets | sort)"
	[ "$want_sorted" = "$cur_sorted" ]
}

# Full desired state: zone base + forwardings + interface membership.
state_ok() {
	rules_present || return 1
	ifaces_synced "$1"
}


remove_ifaces() {
	local batch="" sec
	for sec in $(list_ifaces); do
		batch="${batch}delete network.$sec
"
	done
	[ -n "$batch" ] || return 0
	printf '%s' "$batch" | uci -q batch
	uci -q commit network
	reload_config
}

start() {
	config_load zerotier
	config_foreach get_config zerotier

	# Server-side path validation (defense-in-depth, mirrors general.js regex)
	_local_conf=$(uci -q get zerotier.global.local_conf_path 2>/dev/null)
	_config_path=$(uci -q get zerotier.global.config_path 2>/dev/null)
	[ -n "$_local_conf" ] && { validate_path "$_local_conf" file || return 1; }
	[ -n "$_config_path" ] && { validate_path "$_config_path" dir || return 1; }

	# Disabled or NAT off: make sure no stale rules are left behind
	# (previously these paths returned early without cleanup). The :-0
	# defaults keep this fail-closed when the UCI config is missing
	# entirely (unset vars would otherwise error both guards and fall
	# through to apply_state).
	[ "${enabled:-0}" -eq 0 ] && { remove_rules; log "Service disabled in config."; return 0; }
	[ "${nat:-0}" -eq 0 ] && { remove_rules; log "NAT disabled in config."; return 0; }

	# The zone tracks currently joined networks via interface sections, so
	# there is no need to gate rule creation on daemon/interface readiness —
	# warn only, and install the rules unconditionally.
	$PROG running 2>/dev/null || log "Warning: zerotier service is not running; installing rules anyway"

	apply_state "$(get_nets)"
}

# Hotplug/manual entrypoint: converge firewall rules and interface
# membership onto the currently joined networks (idempotent).
sync() {
	config_load zerotier
	config_foreach get_config zerotier

	[ "${enabled:-0}" -eq 0 ] && { remove_rules; remove_ifaces; log "Service disabled in config."; return 0; }
	[ "${nat:-0}" -eq 0 ] && { remove_rules; remove_ifaces; log "NAT disabled in config."; return 0; }

	apply_state "$(get_nets)"
}

# rc.common's default reload() is "restart" (stop+start): stop() runs the
# runtime-state sync and tears the rules down, so every LuCI Save&Apply
# (ucitrack fires reload on each committed change) churned uci, the
# firewall and the flash twice over (ucitrack + the explicit RPC reload in
# general.js). Defining reload_service() does NOT help here — that hook is
# only honored for procd scripts (USE_PROCD=1); for a plain rc.common
# script the function to override is reload() itself. start() is the
# idempotent no-op this service was always meant to reload with.
reload() {
	start
}

stop() {
	/usr/bin/zerotier-sync.sh 2>/dev/null
	remove_rules
	remove_ifaces
}

# Invoked via the K-link at system shutdown (rc.common's default shutdown()
# would call stop(), churning uci and the firewall for nothing) — only the
# runtime-state sync matters here.
shutdown() {
	/usr/bin/zerotier-sync.sh 2>/dev/null
}
